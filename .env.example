# Copy this file to .env.local (never commit .env.local!) to use your real
# Turso database when testing locally with `node tools/dev.mjs`.
# On Vercel, add the same two values under Project → Settings → Environment Variables.
TURSO_DATABASE_URL=libsql://ballin-yourname.turso.io
TURSO_AUTH_TOKEN=paste-your-token-here
